<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.eland.brand.sample.SampleMapper">

	<insert id="insert" parameterType="Sample" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
		insert into sample (name) values (#{name})
	</insert>

	<select id="findById" resultType="Sample">
		select id, name, created_at from sample where id = #{id}
	</select>

	<select id="findPage" resultType="Sample">
		select id, name, created_at from sample where id &gt; #{afterId} order by id limit #{limit}
	</select>

	<update id="updateName">
		update sample set name = #{name} where id = #{id}
	</update>

	<delete id="deleteById">
		delete from sample where id = #{id}
	</delete>

</mapper>
