  "cards": [
    {
      "dot": "cyan",
      "title": "요청 경로",
      "items": [
        "익명 HTTP 가 SecurityFilterChain 을 그대로 통과한다",
        "요청 본문은 Jackson 이 8KB 상한으로 파싱한다",
        "GET /api/samples 는 afterId 커서로 50건씩 반환한다"
      ]
    },
    {
      "dot": "emerald",
      "title": "계층 규칙",
      "items": [
        "SampleController 는 라우팅과 응답 형태만 담당한다",
        "검증과 페이징 결정은 SampleService 에 모여 있다",
        "SQL 은 SampleMapper.xml 에만 존재한다",
        "테스트는 SampleService 계층에만 둔다"
      ]
    },
    {
      "dot": "rose",
      "title": "보안 현황",
      "items": [
        "SecurityConfig 가 전 경로 permitAll · CSRF 비활성",
        "인가 규칙이 없어 테스트할 대상도 없는 상태",
        "Actuator 와 springdoc 도 같은 열린 체인 위에 있다"
      ]
    }
  ]
